{"data": {"conn_name": "list_jaffle_jaffle_raw", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.15\", \"profile_name\": \"jaffle_shop\", \"target_name\": \"dev\", \"connection_name\": \"list_jaffle_jaffle_raw\"} */\nselect\n      'jaffle' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'jaffle_raw'\n    union all\n    select\n      'jaffle' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'jaffle_raw'\n    union all\n    select\n      'jaffle' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'jaffle_raw'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9465bf83-207d-4df2-b5c7-ac4ba37cd710", "level": "debug", "msg": "On list_jaffle_jaffle_raw: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.15\", \"profile_name\": \"jaffle_shop\", \"target_name\": \"dev\", \"connection_name\": \"list_jaffle_jaffle_raw\"} */\nselect\n      'jaffle' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'jaffle_raw'\n    union all\n    select\n      'jaffle' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'jaffle_raw'\n    union all\n    select\n      'jaffle' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'jaffle_raw'\n  ", "name": "SQLQuery", "pid": 33635, "thread": "ThreadPoolExecutor-0_0", "ts": "2025-12-13T21:32:08.942430Z"}}
