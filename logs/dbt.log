    cast(1 as text)
 as "order_item_id", 
    
    cast(1 as text)
 as "order_id", cast(null as text) as "product_id", cast(null as date) as "order_date", cast(null as text) as "product_name", cast(null as numeric) as "product_price", 
    
    cast(True as boolean)
 as "is_food_item", 
    
    cast(False as boolean)
 as "is_drink_item", cast(null as numeric) as "supply_cost"
union all
select 
    
    cast(2 as text)
 as "order_item_id", 
    
    cast(1 as text)
 as "order_id", cast(null as text) as "product_id", cast(null as date) as "order_date", cast(null as text) as "product_name", cast(null as numeric) as "product_price", 
    
    cast(False as boolean)
 as "is_food_item", 
    
    cast(True as boolean)
 as "is_drink_item", cast(null as numeric) as "supply_cost"
union all
select 
    
    cast(3 as text)
 as "order_item_id", 
    
    cast(2 as text)
 as "order_id", cast(null as text) as "product_id", cast(null as date) as "order_date", cast(null as text) as "product_name", cast(null as numeric) as "product_price", 
    
    cast(True as boolean)
 as "is_food_item", 
    
    cast(False as boolean)
 as "is_drink_item", cast(null as numeric) as "supply_cost"
), orders as (

