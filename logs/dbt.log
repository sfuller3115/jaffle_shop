 as "order_id", cast(null as text) as "location_id", cast(null as text) as "customer_id", cast(null as integer) as "subtotal_cents", cast(null as integer) as "tax_paid_cents", cast(null as integer) as "order_total_cents", cast(null as numeric) as "subtotal", cast(null as numeric) as "tax_paid", cast(null as numeric) as "order_total", cast(null as date) as "order_date"
),  __dbt__cte__order_items as (

