{"data": {"conn_name": "model.jaffle_shop.stg_orders", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "37d0e357f31c1fbe7737db8cf3f0556e9edbc9b8e7ee5b6cbbcfb395467a933e", "node_finished_at": "", "node_name": "stg_orders", "node_path": "staging/stg_orders.sql", "node_relation": {"alias": "stg_orders", "database": "jaffle", "relation_name": "\"jaffle\".\"jaffle\".\"stg_orders\"", "schema": "jaffle"}, "node_started_at": "2025-12-13T21:32:08.969990", "node_status": "executing", "resource_type": "model", "unique_id": "model.jaffle_shop.stg_orders"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.15\", \"profile_name\": \"jaffle_shop\", \"target_name\": \"dev\", \"node_id\": \"model.jaffle_shop.stg_orders\"} */\n\n  \n  with\n\nsource as (\n\n    -- \n    select * from \"jaffle\".\"jaffle_raw\".\"raw_orders\"\n\n),\n\nrenamed as (\n\n    select\n\n        ----------  ids\n        \"ID\" as order_id,\n        \"STORE_ID\" as location_id,\n        \"CUSTOMER\" as customer_id,\n\n        ---------- numerics\n        \"SUBTOTAL\" as subtotal_cents,\n        \"TAX_PAID\" as tax_paid_cents,\n        \"ORDER_TOTAL\" as order_total_cents,\n        (\"SUBTOTAL\"::numeric(16, 2) / 100) as subtotal,\n        (\"TAX_PAID\"::numeric(16, 2) / 100) as tax_paid,\n        (\"ORDER_TOTAL\"::numeric(16, 2) / 100) as order_total,\n\n        ---------- timestamps\n        cast(\"ORDERED_AT\" as date) as order_date\n\n    from source\n\n)\n\nselect * from renamed\n  \n  limit 1000\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9465bf83-207d-4df2-b5c7-ac4ba37cd710", "level": "debug", "msg": "On model.jaffle_shop.stg_orders: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.15\", \"profile_name\": \"jaffle_shop\", \"target_name\": \"dev\", \"node_id\": \"model.jaffle_shop.stg_orders\"} */\n\n  \n  with\n\nsource as (\n\n    -- \n    select * from \"jaffle\".\"jaffle_raw\".\"raw_orders\"\n\n),\n\nrenamed as (\n\n    select\n\n        ----------  ids\n        \"ID\" as order_id,\n        \"STORE_ID\" as location_id,\n        \"CUSTOMER\" as customer_id,\n\n        ---------- numerics\n        \"SUBTOTAL\" as subtotal_cents,\n        \"TAX_PAID\" as tax_paid_cents,\n        \"ORDER_TOTAL\" as order_total_cents,\n        (\"SUBTOTAL\"::numeric(16, 2) / 100) as subtotal,\n        (\"TAX_PAID\"::numeric(16, 2) / 100) as tax_paid,\n        (\"ORDER_TOTAL\"::numeric(16, 2) / 100) as order_total,\n\n        ---------- timestamps\n        cast(\"ORDERED_AT\" as date) as order_date\n\n    from source\n\n)\n\nselect * from renamed\n  \n  limit 1000\n", "name": "SQLQuery", "pid": 33635, "thread": "Thread-1 (worker)", "ts": "2025-12-13T21:32:08.978542Z"}}
